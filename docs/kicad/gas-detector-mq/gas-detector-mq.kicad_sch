	(title_block
		(title "Czujnik gazu — ESP32 DevKit + moduł MH-MQ")
		(date "2026-10-30")
		(rev "0.1")
		(comment 1 "USB→U1; 5V/VIN→MQ VCC; AO 10k/20k→GPIO34/D34; DO 10k/20k→GPIO35/D35")
		(comment 2 "Płytka uniwersalna, bez PCB. Grzałka MQ ~150 mA z 5 V.")
		(comment 3 "Założenie: DOIT DevKit V1 30 pin, USB na dole; złącze MQ VCC GND DO AO.")
		(comment 4 "Alarm: D1 zielona GPIO23, D2 czerwona GPIO22, BZ1 TMB12A05 przez Q1 z GPIO25. Próg 0,35 V.")
	)
